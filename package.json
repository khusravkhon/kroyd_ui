{
  "name": "@kroyd/ui-kit-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@8.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm build:core  && pnpm build:tokens",
    "build:core": "pnpm  -F @kroyd/ui-core build",
    "build:tokens": "pnpm  -F @kroyd/ui-tokens build",
    "storybook": "pnpm  -F @kroyd/ui-docs storybook --port 7007"
  },
  "devDependencies": {
    "shx": "^0.4.0"
  }
}
